# =============================================================================
# autonex-crm-api — backend environment
#
# This file lists every variable the Go gateway and worker read. Nothing here
# belongs in the frontend repo: the web app needs exactly one value from this
# service (its public URL), and none of these secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Supabase: use the SESSION pooler host on port 5432. The direct db.*.supabase.co
# host is IPv6-only and Railway has no IPv6 egress; port 6543 is the
# transaction-mode pooler, which cannot take the session-level advisory lock
# golang-migrate needs. scripts/predeploy.sh warns about both.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gocrm_dev?sslmode=disable

# Session time zone for every database connection. It decides what CURRENT_DATE
# means, and so what "overdue" and "due today" mean across the whole CRM.
APP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
# PORT wins over GATEWAY_ADDR when set — that is how Railway hands the container
# its assigned port. GATEWAY_ADDR is the local knob.
GATEWAY_ADDR=:8080

# CROSS-REPO: the web app's public origin, exact and without a trailing path.
# Two things depend on it:
#   1. CORS — pkg/middleware/cors.go compares the Origin header to this string.
#   2. SSO — the provider callback redirects to <WEB_APP_URL>/app#token=...
# Production: https://dealbridge.autonexai360.com
WEB_APP_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Changing JWT_SECRET invalidates every issued access token immediately. Keep the
# same value across a deploy cutover or every user is signed out.
JWT_SECRET=change-me-in-production-dev-secret-key-12345
JWT_ISSUER=go-crm
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# -----------------------------------------------------------------------------
# OAuth / SSO
# -----------------------------------------------------------------------------
# Public base of the SSO routes. The provider callback is "<base>/<provider>/callback",
# and Google matches the registered redirect URI exactly.
# Production: https://apidealbridge.autonexai360.com/api/v1/auth/sso
OIDC_REDIRECT_BASE=http://localhost:8080/api/v1/auth/sso

# Signing in and connecting a calendar are separate consents, so this is a
# separate redirect base from OIDC_REDIRECT_BASE — register BOTH callback URLs.
# Production: https://apidealbridge.autonexai360.com/api/v1/integrations
INTEGRATIONS_REDIRECT_BASE=http://localhost:8080/api/v1/integrations

# A provider is enabled only when its CLIENT_ID is non-empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Restrict SSO to your own Workspace. Comma-separated; empty means any domain the
# provider lets through can create an account.
SSO_ALLOWED_DOMAINS=autonexai360.com

# Organization that SSO signups join, so colleagues land in one workspace instead
# of each getting their own. An id, not a name, because a workspace can be
# renamed. Empty gives every SSO signup a personal workspace.
SSO_DEFAULT_ORG_ID=

# -----------------------------------------------------------------------------
# Notification email (optional — leave SMTP_HOST or SMTP_FROM blank to disable)
# -----------------------------------------------------------------------------
# When a deal card moves on the board, everyone in the organization except the
# person who moved it is emailed. With either value empty the notification is
# skipped silently and nothing else changes.
# Port 465 uses implicit TLS; any other port negotiates STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=go-CRM

# -----------------------------------------------------------------------------
# Event bus (cmd/worker only — the gateway does not connect to NATS)
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
